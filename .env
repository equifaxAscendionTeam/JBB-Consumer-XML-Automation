# Login method: LMA or DIRECT
LOGIN_MODE=LMA

# Direct Salesforce login
# Used only when LOGIN_MODE=DIRECT
SF_BASE_URL=https://login.salesforce.com/
SF_USERNAME=
SF_PASSWORD=

# LMA login
# Used only when LOGIN_MODE=LMA
LMA_URL=https://equifax-isv-lmo.my.salesforce.com/
LMA_USERNAME=
LMA_PASSWORD=

# Subscriber org to open through LMA
SUBSCRIBER_ORG_ID=00D6g0000023N95
SUBSCRIBER_ORG_NAME=JB&B Capital, LLC


# Consumer XML Settings

# Salesforce Consumer Report list view name
LIST_VIEW_NAME=Custom

# Default number of months to process
# Used when START_DATE and END_DATE are blank
MONTH_RANGE=3

# Optional specific date range
# Format: YYYY-MM-DD
# Both START_DATE and END_DATE must be provided together
START_DATE=2026-05-01
END_DATE=2026-08-31

# Example:
# START_DATE=2026-01-19
# END_DATE=2026-11-16


# Download location
# Leave blank to use the default Downloads folder
DOWNLOAD_PATH=